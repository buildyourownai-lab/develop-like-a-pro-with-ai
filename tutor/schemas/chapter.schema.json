{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Author chapter contract; not reader completion state",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "number",
    "title",
    "outcome",
    "project",
    "start_state",
    "previously_completed_features",
    "required_services",
    "required_credentials",
    "tools_and_packages",
    "new_features",
    "out_of_scope",
    "objectives",
    "handoff",
    "reference_binding",
    "hint_topics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^ch(0[1-9]|1[0-9]|2[0-2])$"
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 22
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "criterion",
          "required",
          "depends_on",
          "evidence_types",
          "expected_outcome",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_outcome": {
            "enum": [
              "pass",
              "expected-failure-observed"
            ]
          }
        }
      }
    },
    "hint_topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "symptom",
          "levels",
          "solution"
        ],
        "properties": {
          "levels": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
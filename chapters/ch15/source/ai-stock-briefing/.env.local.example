# 공공데이터포털(data.go.kr)에서 발급받은 인증키를 넣는 자리다.
# 금융위원회_주식시세정보, 금융위원회_지수시세정보, KRX상장종목정보 세 API가
# 같은 값을 함께 사용한다.
#
# 이 파일은 예시일 뿐이다. 실제 값은 이 파일을 복사해 만든 `.env.local`에 넣는다.
# `.env.local`은 .gitignore에 의해 Git에 올라가지 않는다.

DATA_GO_KR_SERVICE_KEY=

# OpenDART(opendart.fss.or.kr)에서 발급받은 인증키를 넣는 자리다.
# 전자공시(DART) 관련 API 호출에 사용한다.
OPEN_DART_API_KEY=

# Google AI Studio(Gemini API)에서 발급받은 API 키를 넣는 자리다.
# NEXT_PUBLIC_ 접두사를 붙이지 않는다 — 붙이면 브라우저 번들에 값이 그대로 노출된다.
# 서버 쪽 코드(Route Handler, Server Action 등)에서만 읽어 사용한다.
GEMINI_API_KEY=

# Supabase 프로젝트의 Postgres 연결 문자열을 넣는 자리다. (12장)
# 이 값이 없으면 Vercel이 Supabase 저장소 연동 시 자동으로 넣어주는
# POSTGRES_URL을 대신 읽는다. 로컬에서는 이 이름을 그대로 쓴다.
SUPABASE_DATABASE_URL=

# Upstash Redis REST API 주소와 토큰을 넣는 자리다. (12장)
# 이 값들이 없으면 Vercel이 Upstash 저장소 연동 시 자동으로 넣어주는
# KV_REST_API_URL·KV_REST_API_TOKEN을 대신 읽는다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 위 값들은 http://localhost:3000/setup 화면에서 채워도 된다. 그 화면은
# localhost에서 열었을 때만 동작하고, 빈칸으로 둔 항목은 기존 값을 그대로 둔다.

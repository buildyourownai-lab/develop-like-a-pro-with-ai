{
  "name": "book-stock-ch11",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}

# 이 파일은 이름만 보여주는 예시입니다. 실제 값은 .env.local에 넣고 Git에 올리지 않습니다.
# Next.js는 이 이름들을 서버에서만 읽습니다. NEXT_PUBLIC_ 접두사가 없으므로 브라우저 코드에는 노출되지 않습니다.

# --- YouTube 댓글용 OAuth (범위: youtube.force-ssl 하나) ---
# 두 가지 자격증명이 필요합니다.
#   1) 18장에서 만든 OAuth Desktop client JSON (읽기 전용으로 재사용, 이 앱은 절대 덮어쓰지 않습니다)
#   2) npm run setup:youtube-comment-read 가 만드는 댓글용 Token JSON
# 각 자격증명은 "파일 경로"로 주거나 "값 자체"로 줄 수 있습니다.
#
#   내 컴퓨터        → _PATH 쪽에 파일 경로를 넣습니다(권장). 비밀값이 환경변수에 남지 않습니다.
#   배포한 서버      → _JSON 쪽에 내용을 넣습니다. Vercel 같은 곳에는 이 파일들을 둘 수 없습니다.
#
# 한 자격증명에 대해 두 이름을 동시에 채우면 서버는 그 자격증명을 아예 거절합니다.
# (어느 쪽을 쓸지 임의로 정하면, 잊고 남겨 둔 옛 비밀값이 계속 쓰이는데 증상은 엉뚱한 곳을
#  가리키게 됩니다. 그래서 "둘 중 정확히 하나"입니다.) 두 자격증명은 서로 독립이라
# client는 _JSON, token은 _PATH 처럼 섞어 쓰는 것도 됩니다.

# 값으로 주는 방식: JSON 그대로 넣거나, 한 줄로 만든 base64를 넣습니다.
# 배포 화면의 입력칸은 한 줄이라 여러 줄 JSON을 붙이면 줄바꿈이 깨지기 쉬우므로 base64를 권합니다.
#   base64 < client_secret_XXXX.json | tr -d '\n'
#   base64 < .secrets/youtube-comment-read-oauth.json | tr -d '\n'
YOUTUBE_OAUTH_CLIENT_JSON=
# 같은 client JSON을 파일로 주는 경우의 경로 (위와 동시에 채우지 않습니다)
YOUTUBE_OAUTH_CLIENT_JSON_PATH=

# 댓글용 Token. YouTube Data API v3 공식 Discovery 문서 기준으로 commentThreads.list,
# comments.list, comments.insert 를 실제로 허용하는 범위는
# https://www.googleapis.com/auth/youtube.force-ssl 뿐입니다 — 18장 상태변경(status-change)
# Token(범위 .../auth/youtube)도, youtube.readonly Token도 이 범위를 부여하지 않으므로
# 재사용할 수 없습니다. 이 앱은 force-ssl "하나만" 정확히 들어 있는 Token을 받고, 다른 범위가
# 섞여 있으면(force-ssl이 함께 있어도) 네트워크 호출 전에 거절합니다.
# npm run setup:youtube-comment-read 로 이 장 전용 Token을 만드세요.
YOUTUBE_OAUTH_COMMENT_READ_TOKEN_JSON=
# 같은 Token JSON을 파일로 주는 경우의 경로 (위와 동시에 채우지 않습니다)
YOUTUBE_OAUTH_COMMENT_READ_TOKEN_PATH=.secrets/youtube-comment-read-oauth.json

# Gemini 분류·초안·검사용
GEMINI_API_KEY=
GEMINI_MODEL=

# --- 20장: 자동답글 상태 저장소와 실행 열쇠 ---
# 아래 이름이 비어 있으면 /api/auto-reply/* 는 아무 일도 하지 않습니다.
# 자동답글의 기본값은 "꺼짐"이고, 이 값을 채워도 저절로 켜지지 않습니다.

# Supabase 프로젝트 주소 (https://<프로젝트>.supabase.co)
SUPABASE_URL=
# service_role 키. 서버에서만 읽고, 요청 헤더로만 보냅니다 — URL·SQL·로그에 넣지 않습니다.
# 브라우저에 노출되면 안 되므로 NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 예약 실행(/api/auto-reply/run)을 부를 때 Authorization: Bearer 로 보내는 열쇠.
# 이 값이 없으면 /api/auto-reply/run 은 누가 불러도 항상 거절합니다(열려 있는 상태가 없습니다).
# 만드는 예: openssl rand -base64 32
# 같은 값을 Supabase Vault에도 넣습니다 — supabase/cron/README.md 참고.
AUTO_REPLY_SCHEDULER_SECRET=
# 사람이 쓰는 경로(prepare/enable/send/stop/status)의 열쇠.
# 내 컴퓨터(개발 모드)에서는 비워 두어도 되지만, 배포한 서버에서는 반드시 채워야 열립니다.
AUTO_REPLY_OPERATOR_SECRET=
# 승인 Token(/api/auto-reply/prepare 가 주고 /send 가 확인하는 서명)에 쓰는 열쇠.
# 비워 두면 AUTO_REPLY_OPERATOR_SECRET 을 쓰고, 그것도 없으면 프로세스마다 임의 값을 만듭니다
# (그 경우 서버를 재시작하면 발급해 둔 승인이 모두 무효가 됩니다 — 안전한 쪽으로 실패).
# 운영자 열쇠를 교체할 때 발급된 승인을 함께 무효화하고 싶지 않다면 이 이름을 따로 채우세요.
AUTO_REPLY_APPROVAL_SECRET=

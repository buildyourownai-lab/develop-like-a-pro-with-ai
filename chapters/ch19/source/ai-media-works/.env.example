# 이 파일은 이름만 보여주는 예시입니다. 실제 값은 .env.local에 넣고 Git에 올리지 않습니다.
# Next.js는 이 이름들을 서버에서만 읽습니다. NEXT_PUBLIC_ 접두사가 없으므로 브라우저 코드에는 노출되지 않습니다.

# YouTube 댓글 읽기용 OAuth (youtube.force-ssl)
# 값을 여기에 직접 넣지 않습니다 — 두 파일의 "경로"만 넣습니다. 파일 내용은
# npm run setup:youtube-comment-read (scripts/setup-youtube-comment-read-oauth.mjs)가
# 만들며, README의 "로컬 OAuth 설정" 절을 먼저 읽으세요.
# 18장에서 만든 OAuth Desktop client JSON 경로 (읽기 전용으로 재사용, 이 앱은 절대 덮어쓰지 않습니다)
YOUTUBE_OAUTH_CLIENT_JSON_PATH=
# 댓글 읽기용 Token 파일 경로. YouTube Data API v3 공식 Discovery 문서 기준으로
# commentThreads.list를 실제로 허용하는 범위는 https://www.googleapis.com/auth/youtube.force-ssl
# 뿐입니다 — 18장 상태변경(status-change) Token(범위 .../auth/youtube)도,
# youtube.readonly Token도 이 범위를 부여하지 않으므로 재사용할 수 없습니다.
# npm run setup:youtube-comment-read로 이 장 전용의 새 force-ssl Token을 만들고,
# 그 스크립트가 저장하는 고정 경로를 넣으세요.
YOUTUBE_OAUTH_COMMENT_READ_TOKEN_PATH=.secrets/youtube-comment-read-oauth.json

# Gemini 분류·초안·검사용
GEMINI_API_KEY=
GEMINI_MODEL=
